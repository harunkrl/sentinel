# Production Environment Variables
# Copy this file to .env and update values before deploying

# InfluxDB Configuration
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DOCKER_INFLUXDB_INIT_ORG=sentinel
DOCKER_INFLUXDB_INIT_BUCKET=metrics
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=GENERATE_A_SECURE_TOKEN_HERE

# Sentinel Core Configuration
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=SAME_AS_INIT_ADMIN_TOKEN_ABOVE
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=metrics
NTFY_TOPIC=your-private-random-topic-name

# Security Configuration (CRITICAL - Change these!)
JWT_SECRET=GENERATE_A_64_CHAR_RANDOM_STRING_HERE

# Server Configuration
# Set to your actual domain(s), comma-separated
CORS_ALLOWED_ORIGINS=https://sentinel.yourdomain.com

# Data Storage
DATA_DIR=/data

# Optional Tuning
# METRIC_INTERVAL_SECONDS=2     # Agent metric collection interval (default: 2)
# ALERT_DEBOUNCE_MINUTES=5      # Alert notification cooldown (default: 5)
# GRPC_PORT=50051                # gRPC server port (default: 50051)
