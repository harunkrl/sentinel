# InfluxDB Configuration
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpassword
DOCKER_INFLUXDB_INIT_ORG=sentinel
DOCKER_INFLUXDB_INIT_BUCKET=metrics
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=my-super-secret-admin-token

# Sentinel Core Configuration
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-admin-token
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=metrics
NTFY_TOPIC=sentinel-command-private-alarm-channel

# Security Configuration (REQUIRED)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Data Storage
DATA_DIR=/data

# Server Configuration
CORS_ALLOWED_ORIGINS=*

# Optional Tuning
# METRIC_INTERVAL_SECONDS=2     # Agent metric collection interval (default: 2)
# ALERT_DEBOUNCE_MINUTES=5      # Alert notification cooldown (default: 5)
# GRPC_PORT=50051                # gRPC server port (default: 50051)
