# --- SECURITY WARNING ---
# CHANGE ALL PASSWORDS AND TOKENS BEFORE DEPLOYING TO PRODUCTION!
# Use `openssl rand -hex 32` to generate secure 64-char tokens.

# InfluxDB Configuration
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DOCKER_INFLUXDB_INIT_ORG=sentinel
DOCKER_INFLUXDB_INIT_BUCKET=metrics

# CRITICAL: This token MUST match INFLUXDB_TOKEN below!
# Generate one: openssl rand -hex 32
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=GENERATE_A_SECURE_TOKEN_HERE

# Sentinel Core Configuration
INFLUXDB_URL=http://influxdb:8086
# MUST MATCH DOCKER_INFLUXDB_INIT_ADMIN_TOKEN ABOVE!
INFLUXDB_TOKEN=GENERATE_A_SECURE_TOKEN_HERE
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=metrics
NTFY_TOPIC=sentinel_alerts_CHANGE_ME

# Security Configuration (REQUIRED)
# Generate one: openssl rand -hex 32
JWT_SECRET=GENERATE_A_SECURE_JWT_SECRET_HERE

# Data Storage
DATA_DIR=/data

# Server Configuration
# Restrict this to your specific domain (e.g. https://sentinel.example.com)
CORS_ALLOWED_ORIGINS=https://sentinel.yourdomain.com

# Optional Tuning
METRIC_INTERVAL_SECONDS=5     # Slower interval for prod to save disk space
ALERT_DEBOUNCE_MINUTES=15     # Reduce alert noise
GRPC_PORT=50051
